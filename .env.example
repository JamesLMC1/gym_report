# Copia este archivo como .env y completa tus valores
# cp .env.example .env

# API key de OpenCode Zen: https://opencode.ai/auth
OPENCODE_API_KEY=

# Modelo a usar (DeepSeek V4 Flash disponible en OpenCode Zen)
OPENCODE_MODEL=deepseek-v4-flash

# Endpoint compatible con OpenAI de OpenCode Zen
# Si tienes suscripción OpenCode Go usa: https://opencode.ai/zen/go/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Microservicio de datos (resiliencia con fallback) ---
# La app llama primero a la primaria; si falla, a las de respaldo.
MICROSERVICE_PRIMARY_URL=https://microserviciogym.onrender.com
# URLs de respaldo (otro lenguaje), separadas por coma. Ej:
# MICROSERVICE_FALLBACK_URLS=https://mi-fallback-node.onrender.com,https://mi-fallback-go.onrender.com
MICROSERVICE_FALLBACK_URLS=https://micro-go-kcpn.onrender.com,https://micro-java.onrender.com,https://micro-python-f0ea.onrender.com
# Timeout por intento (s) y cooldown (s) antes de reintentar una base caída
MICROSERVICE_TIMEOUT=15
MICROSERVICE_COOLDOWN=30
